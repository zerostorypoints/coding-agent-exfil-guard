{
  "description": "coding-agent-exfil-guard: taint tracking, outbound gating, injection alerts",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" claude",
            "timeout": 10,
            "onFailure": "block",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" claude",
            "timeout": 15,
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" claude",
            "timeout": 15,
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
